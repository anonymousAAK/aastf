{
  "name": "@aastf/core",
  "version": "0.1.0-beta.1",
  "description": "TypeScript SDK for the Agentic AI Security Testing Framework (AASTF)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "aastf": "./dist/cli.js",
    "aastf-standalone": "./dist/standalone-cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./adapters": {
      "import": "./dist/adapters/index.js",
      "types": "./dist/adapters/index.d.ts"
    },
    "./adapters/openai-agents": {
      "import": "./dist/adapters/openai-agents.js",
      "types": "./dist/adapters/openai-agents.d.ts"
    },
    "./adapters/langchainjs": {
      "import": "./dist/adapters/langchainjs.js",
      "types": "./dist/adapters/langchainjs.d.ts"
    },
    "./adapters/mastra": {
      "import": "./dist/adapters/mastra.js",
      "types": "./dist/adapters/mastra.d.ts"
    },
    "./adapters/vercel-ai": {
      "import": "./dist/adapters/vercel-ai.js",
      "types": "./dist/adapters/vercel-ai.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "aastf",
    "ai-security",
    "agentic-ai",
    "owasp",
    "security-testing",
    "red-teaming",
    "mcp"
  ],
  "author": "AASTF Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/anonymousAAK/aastf",
    "directory": "packages/aastf-js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "eslint": "^9.5.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
